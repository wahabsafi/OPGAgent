# LangSmith tracing (easy to inspect traces in LangSmith console)
# Copy to .env and fill in real values, or export via environment variables
# LangSmith tracing is enabled by default; use --no-langsmith to disable

LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=opgagent

# OpenAI (Agent brain LLM + llm_zoo_openai voter)
OPENAI_API_KEY=your-openai-api-key

# Gemini (Used by llm_zoo_google in LLM Zoo; takes precedence over GOOGLE_API_KEY)
GEMINI_API_KEY=your-gemini-api-key

# Optional: Tool service overrides, see tools_config.yaml
# DASHSCOPE_API_KEY=...   # Qwen
# OPENAI_BASE_URL=...

